{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.3.18",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "short_name": "msg_support",
    "permissions": [
        "tabs",
        "activeTab",
        "storage",
        "identity",
        "scripting",
        "webNavigation",
        "contextMenus",
        "notifications",
        "downloads",
        "windows",
        "alarms",
        "declarativeNetRequestWithHostAccess",
        "webRequest",
        "proxy",
        "webRequestAuthProvider",
        "browsingData",
        "cookies"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "assets/images/icon-16x16.png",
            "64": "assets/images/icon-48x48.png",
            "128": "assets/images/icon-128x128.png"
        },
        "default_title": "__MSG_extName__"
    },
    "icons": {
        "16": "assets/images/icon-16x16.png",
        "64": "assets/images/icon-48x48.png",
        "128": "assets/images/icon-128x128.png"
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "block_rules",
                "enabled": true,
                "path": "rules/rules.json"
            }
        ]
    },
    "content_scripts": [
        {
            "js": [
                "content-script.js"
            ],
            "matches": [
                "*://*.google/*"
            ],
            "run_at": "document_end",
            "all_frames": true,
            "css": [
                "content-script.ff0c3a0b.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}